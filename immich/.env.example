# Copy this file to immich/.env and fill in the values. immich/.env is git-ignored.
# Values are read verbatim: no quotes, no inline comments, no leading or trailing spaces.
# This file is separate from the root .env, which configures the rest of the stack.

# --- Version ---
# Pinned Immich release. Must match the database and Valkey images in docker-compose.yml.
IMMICH_VERSION=v3.3.5

# --- Network ---
# LAN address of the host, the port is published on this address only.
HOST_IP=<ip-address-of-host>
# Port of the web UI.
IMMICH_PORT=2283

# --- Time ---
# Time zone for logs and timestamps, for example Europe/Berlin. Empty means UTC.
IMMICH_TIMEZONE=

# --- Secrets (internal services) ---
# Password of the database user "immich". Generate with: openssl rand -hex 24
IMMICH_DB_PASSWORD=
# Password of the Valkey cache. Generate with: openssl rand -hex 24
IMMICH_REDIS_PASSWORD=

# --- Storage (host paths, must exist before the first start) ---
# Original photos, read-only inside the container. Host path of the year folders from the NAS.
IMMICH_ORIGINALS_HOST_PATH=<host-path-to-photos>
# Thumbnails, transcoded videos and other generated data. Writable. Regenerable (see README.md).
IMMICH_UPLOAD_DIR=<host-path-for-upload>
# Database files. Writable. Back up with pg_dump, never by copying the files while running.
IMMICH_DB_DIR=<host-path-for-database>
# CLIP and face models. Writable. Downloaded on first use, can be downloaded again.
IMMICH_MODEL_CACHE_DIR=<host-path-for-model-cache>
