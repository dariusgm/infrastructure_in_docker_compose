# Copy this file to .env and fill in the values. .env is git-ignored and holds the
# complete configuration, so keep a backup of it.
# Values are read verbatim: no quotes, no inline comments, no leading or trailing spaces.
# Keep related values together.

# --- Target host (SSH) ---
# HOST_PRIVATE_KEY and HOST_PUBLIC_KEY are generated by: python3 deploy.py keys
HOST_IP=
HOST_USERNAME=
HOST_PASSWORD=
HOST_PRIVATE_KEY=
HOST_PUBLIC_KEY=

# --- Rootless Docker ---
# Ubuntu blocks unprivileged user namespaces through AppArmor, which rootless Docker needs.
# Set to yes only if rootless Docker fails to start because of that. It relaxes a hardening default.
ROOTLESS_RELAX_APPARMOR=no

# --- Network policy ---
# Only this network may reach the host. 192.0.0.0/8 covers all 192.* addresses.
ALLOWED_NETWORK=192.0.0.0/8

# --- Deployment ---
# Git repository that the host clones. It must be reachable without credentials.
REPO_URL=
# Checkout location, relative to the login user's home directory on the host.
DEPLOY_DIR=infrastructure_in_docker_compose
# Persistent data for all components. Kept outside the repository on purpose.
DATA_DIR=/srv/infrastructure/data

# --- Package cache (apt-cache) ---
# Address of the apt-cache service, usually HOST_IP. Used by client.py on every system.
APT_CACHE_HOST=
# apt-cacher-ng port for apt traffic.
APT_CACHE_PORT=3142
# Generic URL proxy port for other downloads, see apt-cache/README.md.
URL_PROXY_PORT=8081

# --- DNS and ad blocking (pihole) ---
# Password for the admin UI at http://<HOST_IP>:8082/admin. Required. Generate one with: openssl rand -hex 24
PIHOLE_PASSWORD=
# Upstream DNS servers for queries that are not blocked, separated by semicolons. The provider's servers are listed first; dnsmasq does not guarantee their order of use.
PIHOLE_UPSTREAM_DNS=88.134.230.225;88.134.230.161;1.1.1.1;9.9.9.9
# Time zone for logs and statistics, for example Europe/Berlin. Empty means UTC.
PIHOLE_TIMEZONE=
