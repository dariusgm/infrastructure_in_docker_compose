# Copy this file to .env and fill in the values. .env is git-ignored and holds the
# complete configuration, so keep a backup of it.
# Values are read verbatim: no quotes, no inline comments, no leading or trailing spaces.
# Keep related values together.

# --- Target host (SSH) ---
# HOST_PRIVATE_KEY and HOST_PUBLIC_KEY are generated by: python3 deploy.py keys
HOST_IP=
HOST_USERNAME=
HOST_PASSWORD=
HOST_PRIVATE_KEY=
HOST_PUBLIC_KEY=

# --- Rootless Docker ---
# Ubuntu blocks unprivileged user namespaces through AppArmor, which rootless Docker needs.
# Set to yes only if rootless Docker fails to start because of that. It relaxes a hardening default.
ROOTLESS_RELAX_APPARMOR=no

# --- Network policy ---
# Only this network may reach the host. 192.0.0.0/8 covers all 192.* addresses.
ALLOWED_NETWORK=192.0.0.0/8

# --- Deployment ---
# Git repository that the host clones. It must be reachable without credentials.
REPO_URL=
# Checkout location, relative to the login user's home directory on the host.
DEPLOY_DIR=infrastructure_in_docker_compose
# Persistent data for all components. Kept outside the repository on purpose.
DATA_DIR=/srv/infrastructure/data

# --- Package cache (apt-cache) ---
# Address of the apt-cache service, usually HOST_IP. Used by client.py on every system.
APT_CACHE_HOST=
# apt-cacher-ng port for apt traffic.
APT_CACHE_PORT=3142
# Generic URL proxy port for other downloads, see apt-cache/README.md.
URL_PROXY_PORT=8081

# --- DNS and ad blocking (pihole) ---
# Password for the admin UI at http://<HOST_IP>:8082/admin. Required. Generate one with: openssl rand -hex 24
PIHOLE_PASSWORD=
# Upstream DNS servers for queries that are not blocked, separated by semicolons. The provider's servers are listed first; dnsmasq does not guarantee their order of use.
PIHOLE_UPSTREAM_DNS=88.134.230.225;88.134.230.161;1.1.1.1;9.9.9.9
# Time zone for logs and statistics, for example Europe/Berlin. Empty means UTC.
PIHOLE_TIMEZONE=

# --- Document management (paperless) ---
# See paperless/README.md. The first five values are required, the stack does not start without them.
# Secret for sessions and signing. Changing it signs every user out. Generate with: openssl rand -hex 64
PAPERLESS_SECRET_KEY=
# Password of the database user "paperless" (PostgreSQL, internal). Generate with: openssl rand -hex 24
PAPERLESS_DB_PASSWORD=
# Password of the internal task broker (Valkey, internal). Generate with: openssl rand -hex 24
PAPERLESS_BROKER_PASSWORD=
# First administrator. Created on the first start only, if the user does not exist yet.
PAPERLESS_ADMIN_USER=
PAPERLESS_ADMIN_PASSWORD=
# Optional: e-mail address of the administrator.
PAPERLESS_ADMIN_MAIL=
# Address in the browser, for example http://192.168.1.10:8083 or a host name. Empty means http://<HOST_IP>:8083.
PAPERLESS_URL=
# Time zone for the paperless containers, for example Europe/Berlin. Empty means UTC.
PAPERLESS_TIMEZONE=
# OCR languages for documents, ISO 639-2 codes joined by "+". Empty means deu+eng.
PAPERLESS_OCR_LANGUAGE=

# --- Photo archive (immich) ---
# See immich/README.md. The values marked "Required" must be set, the stack does not start without them.
# Password of the database user "immich" (PostgreSQL, internal). Required. Generate with: openssl rand -hex 24
IMMICH_DB_PASSWORD=
# Password of the internal Valkey cache (internal). Required. Generate with: openssl rand -hex 24
IMMICH_REDIS_PASSWORD=
# Time zone for the Immich containers, for example Europe/Berlin. Empty means UTC.
IMMICH_TIMEZONE=

# --- Originals (SMB shares on the NAS, read-only) ---
# The host mounts each folder read-only below /mnt/immich-originals/<name> (server/immich-originals-mount.sh).
# All folders use one NAS user with read rights only. It is separate from the Paperless user (SMB_*).
# IP address of the NAS. Required.
IMMICH_SMB_HOST=<ip-address-of-nas>
# Read-only user on the NAS. Required.
IMMICH_SMB_USERNAME=<readonly-user>
# Password of that user. Required.
IMMICH_SMB_PASSWORD=<password>
# Folder 1: share name and folder inside the share. Spaces are allowed in the folder. Both required.
IMMICH_SMB_1_SHARE=<share-name>
IMMICH_SMB_1_SUBPATH=<folder-in-share>
# Folder 2: share name and folder inside the share. Both required.
IMMICH_SMB_2_SHARE=<share-name>
IMMICH_SMB_2_SUBPATH=<folder-in-share>
# Folder 3: share name and folder inside the share. Both required.
IMMICH_SMB_3_SHARE=<share-name>
IMMICH_SMB_3_SUBPATH=<folder-in-share>

# --- Backups (backup) ---
# Number of backups kept for each kind: paperless database, paperless files, Pi-hole databases. Empty means 14 (about two weeks of daily backups).
BACKUP_KEEP_COUNT=


# --- Consume share (SMB on the NAS) ---
# Paperless imports new documents from this share. The host mounts it at /mnt/paperless-consume (server/consume-mount.sh).
# IP address of the NAS. Required.
SMB_HOST=<ip-address-of-nas>
# Name of the share on the NAS. Required.
SMB_SHARE=<share-name>
# Folder inside the share that Paperless consumes from. Empty means the share root.
SMB_SUBPATH=
# User on the NAS that can read and write the folder. Required.
SMB_USERNAME=paperless
# Password of that user. Required.
SMB_PASSWORD=<password>
