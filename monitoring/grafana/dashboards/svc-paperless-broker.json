          "expr": "sum(rate(redis_keyspace_hits_total{job=\"valkey-paperless\"}[$__rate_interval])) / (sum(rate(redis_keyspace_hits_total{job=\"valkey-paperless\"}[$__rate_interval])) + sum(rate(redis_keyspace_misses_total{job=\"valkey-paperless\"}[$__rate_interval])))",
